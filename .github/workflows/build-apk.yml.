name: Build APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21
      - name: Pasang Capacitor
        run: |
          npm install @capacitor/core @capacitor/android @capacitor/local-notifications
          npm install -D @capacitor/cli @capacitor/assets
      - name: Buat proyek Android
        run: |
          npx cap add android
          node scripts/patch-manifest.js
          npx @capacitor/assets generate --android
          npx cap sync android
      - name: Build APK
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: habit-tracker-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
